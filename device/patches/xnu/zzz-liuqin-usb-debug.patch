@@ -219,10 +219,39 @@
 
 TUNABLE(startup_debug_t, startup_debug, "startup_debug", 0);
 
+/* liuqin: panel-only milestone trace. Runs before kprintf is usable and must
+ * survive a hang, so it never touches the console layer. */
+void
+liuqin_milestone(const char *tag, const char *msg)
+{
+	extern void liuqin_debug_puts(const char *s);
+	extern void liuqin_debug_putc(char c);
+	static unsigned count;
+	char num[12];
+	unsigned n = ++count;
+	unsigned i = 0;
+
+	/* the panel scrolls whole pages, so print a sequence number as well: the
+	 * last line then always carries the highest number and the order is not a
+	 * matter of reading the wrap point correctly. */
+	liuqin_debug_putc(tag[0]);
+	do {
+		num[i++] = (char)('0' + n % 10);
+		n /= 10;
+	} while (n != 0);
+	while (i != 0) {
+		liuqin_debug_putc(num[--i]);
+	}
+	liuqin_debug_putc(':');
+	liuqin_debug_puts(msg);
+	liuqin_debug_putc('\n');
+}
