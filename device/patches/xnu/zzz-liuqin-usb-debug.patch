--- /dev/null
+++ b/bsd/dev/liuqin_usb_protocol.h
@@ -0,0 +1,75 @@
+/* CDC ACM descriptors and request whitelist for the liuqin USB debug port.
+ * Lab VID/PID 1209:0002, synthetic serial LIQDBG001. Ported from vermeer.
+ */
+#ifndef LIUQIN_USB_PROTOCOL_H
+#define LIUQIN_USB_PROTOCOL_H
+#ifdef LIUQIN_HOST_TEST
+#include <stdint.h>
+#else
+#include <sys/types.h>
+#endif
+static const uint8_t lqusb_device[18] = {
+	18, 1, 0x00, 0x02, 2, 2, 1, 64, 0x09, 0x12, 0x02, 0x00, 0, 4, 1, 2, 3, 1
+};
+static const uint8_t lqusb_config[67] = {
+	9, 2, 67, 0, 2, 1, 0, 0x80, 250,
+	9, 4, 0, 0, 1, 2, 2, 1, 0,
+	5, 0x24, 0, 0x10, 1,
+	5, 0x24, 1, 0, 1,
+	4, 0x24, 2, 2,
+	5, 0x24, 6, 0, 1,
+	7, 5, 0x82, 3, 16, 0, 9,
+	9, 4, 1, 0, 2, 0x0a, 0, 0, 0,
+	7, 5, 0x01, 2, 0, 2, 0,
+	7, 5, 0x81, 2, 0, 2, 0
+};
+static const uint8_t lqusb_qualifier[10] = { 10, 6, 0, 2, 2, 2, 1, 64, 1, 0 };
+
+/* The DMA block must be one aligned contiguous run inside the caller supplied
+ * window, and the controller must be able to address all of it. */
+static inline int lqusb_dma_allowed(uint64_t pa, unsigned size, unsigned bits,
+    uint64_t lo, uint64_t hi)
+{
+	if (size != 0x4000 || (pa & 0x3fff)) return 0;
+	if (!lo || hi <= lo || pa < lo || pa >= hi) return 0;
+	if (size > hi - pa) return 0;
+	if (bits < 32 || bits > 64) return 0;
+	return bits == 64 || pa + size - 1 < (1ULL << bits);
+}
+
+/* Exactly one nonsecure stream must match the USB stream ID and its route must
+ * be identity (or bypass): the port never creates or weakens a mapping. */
+static inline int lqusb_stream_match(uint32_t smr, uint32_t sid)
+{
+	return (smr >> 31) && !((smr ^ sid) & ~((smr >> 16) & 0x7fff) & 0xffff);
+}
+static inline int lqusb_route_identity(uint32_t s2cr, uint32_t cbar, uint32_t sctlr)
+{
+	unsigned type = (s2cr >> 16) & 3;
+	return type == 1 || (type == 0 && ((cbar >> 16) & 3) == 1 && !(sctlr & 1));
+}
+
+/* Recognised request kinds only; malformed class OUT lengths stall. */
+enum {
+	LQUSB_BAD, LQUSB_DESC, LQUSB_ADDRESS, LQUSB_CONFIG, LQUSB_GET_CONFIG,
+	LQUSB_STATUS, LQUSB_INTERFACE, LQUSB_GET_INTERFACE, LQUSB_SET_LINE,
+	LQUSB_GET_LINE, LQUSB_CONTROL, LQUSB_BREAK, LQUSB_CLEAR_HALT
+};
+static inline int lqusb_request(uint8_t type, uint8_t req, uint16_t value,
+    uint16_t index, uint16_t len)
+{
+	if (type == 0x80 && req == 6 && ((value >> 8) >= 1 && (value >> 8) <= 7)) return LQUSB_DESC;
+	if (type == 0 && req == 5 && !index && !len && value < 128) return LQUSB_ADDRESS;
+	if (type == 0 && req == 9 && !index && !len && value <= 1) return LQUSB_CONFIG;
+	if (type == 0x80 && req == 8 && !value && !index && len == 1) return LQUSB_GET_CONFIG;
+	if ((type == 0x80 || type == 0x81 || type == 0x82) && req == 0 && !value && len == 2) return LQUSB_STATUS;
+	if (type == 1 && req == 11 && index <= 1 && !value && !len) return LQUSB_INTERFACE;
+	if (type == 0x81 && req == 10 && index <= 1 && !value && len == 1) return LQUSB_GET_INTERFACE;
+	if (type == 0x21 && req == 0x20 && !index && !value && len == 7) return LQUSB_SET_LINE;
+	if (type == 0xa1 && req == 0x21 && !index && !value && len == 7) return LQUSB_GET_LINE;
+	if (type == 0x21 && req == 0x22 && !index && !len && !(value & ~3)) return LQUSB_CONTROL;
+	if (type == 0x21 && req == 0x23 && !index && !len) return LQUSB_BREAK;
+	if (type == 2 && req == 1 && !value && !len && (index == 1 || index == 0x81 || index == 0x82)) return LQUSB_CLEAR_HALT;
+	return LQUSB_BAD;
+}
+#endif
