+
+static unsigned lq_text_x, lq_text_y;
+static bool lq_text_disabled;
+
+extern vm_map_t kernel_map;
+extern int PE_parse_boot_argn(const char *, void *, unsigned int);
+static bool
+lq_u64(const char **text, uint64_t *value)
+{
+	const char *s = *text;
+	uint64_t v = 0;
+	unsigned base = 10, digits = 0;
+
+	while (*s == ' ') {
+		s++;
+	}
+	if (s[0] == '0' && (s[1] == 'x' || s[1] == 'X')) {
+		base = 16;
+		s += 2;
+	}
+	for (;; s++) {
+		unsigned d;
+		if (*s >= '0' && *s <= '9') {
+			d = (unsigned)(*s - '0');
+		} else if (base == 16 && *s >= 'a' && *s <= 'f') {
+			d = (unsigned)(*s - 'a') + 10;
+		} else if (base == 16 && *s >= 'A' && *s <= 'F') {
+			d = (unsigned)(*s - 'A') + 10;
+		} else {
+			break;
+		}
+		v = v * base + d;
+		if (++digits > 16) {
+			return false;
+		}
+	}
+	if (!digits) {
+		return false;
+	}
+	*text = s;
+	*value = v;
+	return true;
+}
+
+static void
+lq_text_clear(void)
+{
+	for (unsigned row = 280; row < 280 + 32 * 40; row++) {
+		uint32_t *line = lq_fb + (uint64_t)row * lq_fb_stride_px;
+		for (unsigned x = 0; x < lq_fb_width; x++) {
+			line[x] = 0;
+		}
+	}
+}
+
+void
+liuqin_fb_putc(char c)
+{
+	if (lq_text_disabled) {
+		return;
+	}
+	if (!lq_fb) {
+		/* ml_io_map needs kernel_map; before vm_init the console byte is lost. */
+		if (!kernel_map) {
+			return;
+		}
+		lq_text_disabled = true;
+		{
+			char spec[64];
+			uint64_t base = 0xb8000000ULL, width = 1800, height = 2880, stride = 7200;
+			if (PE_parse_boot_argn("fb", spec, sizeof(spec))) {
+				const char *text = spec;
+				uint64_t part[4];
+				unsigned n = 0;
+				while (n < 4 && lq_u64(&text, &part[n])) {
+					n++;
+					if (*text != ',') {
+						break;
+					}
+					text++;
+				}
+				if (n == 4) {
+					base = part[0]; width = part[1]; height = part[2]; stride = part[3];
+				}
+			}
+			liuqin_fb_bind(base, (uint32_t)width, (uint32_t)height, (uint32_t)stride);
+		}
+		if (!lq_fb) {
+			return;
+		}
+		lq_text_disabled = false;
+	}
+	if (c == '\r') {
+		lq_text_x = 0;
+		return;
+	}
+	if (c == '\n') {
+		lq_text_x = 0;
+		lq_text_y++;
+		if (280 + (lq_text_y + 1) * 32 > 2880) {
+			lq_text_clear();
+			lq_text_y = 0;
+		}
+		return;
+	}
+	if ((unsigned char)c < 0x20) {
+		return;
+	}
+	if (lq_text_x + 16 > lq_fb_width) {
+		lq_text_x = 0;
+		lq_text_y++;
+	}
+	unsigned glyph = (unsigned char)c - 0x20;
+	if (glyph > 94) {
+		glyph = '?' - 0x20;
+	}
+	const uint8_t *rows = lq_font[glyph];
+	for (unsigned gy = 0; gy < 16; gy++) {
+		uint64_t top = 280 + lq_text_y * 32 + gy * 2;
+		for (unsigned gx = 0; gx < 8; gx++) {
+			uint32_t color = (rows[gy] & (0x80u >> gx)) ? 0xffffffffu : 0;
+			for (unsigned dy = 0; dy < 2; dy++) {
+				uint32_t *line = lq_fb + (top + dy) * (uint64_t)lq_fb_stride_px + lq_text_x + gx * 2;
+				line[0] = color;
+				line[1] = color;
+			}
+		}
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+	lq_text_x += 16;
+}
+
+/* Boot black box: stage words the loader reads back on the next boot.
+ * Writes go to an ordinary kernel global, valid both while the bootstrap
+ * tables are live and after pmap_bootstrap installs the real ones. */
+volatile uint32_t lq_rec[24] = { 0x4c515231u };
+
+void
+liuqin_stage(unsigned stage)
+{
+	static unsigned next;
+
+	if (next + 1 < 24) {
+		lq_rec[1 + next] = stage;
+		next++;
+	}
+	liuqin_early_marker(stage);
+}
diff --git a/bsd/dev/liuqin_log_ring.h b/bsd/dev/liuqin_log_ring.h
new file mode 100644
index 0000000..049e603
--- /dev/null
+++ b/bsd/dev/liuqin_log_ring.h
@@ -0,0 +1,45 @@
+/* One megabyte console mirror ring: no allocation, no filesystem IO.
+ * The caller supplies the lock; every access is bounded.
+ */
+#ifndef LIUQIN_LOG_RING_H
+#define LIUQIN_LOG_RING_H
+#ifdef LIUQIN_HOST_TEST
+#include <stdint.h>
+#else
+#include <sys/types.h>
+#endif
+#ifndef LQ_RING_SIZE
+#define LQ_RING_SIZE (1u << 20)
+#endif
+struct lq_ring {
+	uint64_t total;
+	char bytes[LQ_RING_SIZE];
+};
+static inline void lq_append(struct lq_ring *r, const char *s, unsigned n)
+{
+	uint64_t at = r->total;
+	r->total += n;
+	if (n > LQ_RING_SIZE) {
+		unsigned skip = n - LQ_RING_SIZE;
+		s += skip;
+		at += skip;
+		n = LQ_RING_SIZE;
+	}
+	for (unsigned i = 0; i < n; i++) {
+		r->bytes[(at + i) % LQ_RING_SIZE] = s[i];
+	}
+}
+static inline unsigned lq_copy(const struct lq_ring *r, uint64_t *pos, char *out,
+    unsigned max)
+{
+	if (*pos > r->total) *pos = 0;
+	if (r->total - *pos > LQ_RING_SIZE) *pos = r->total - LQ_RING_SIZE;
+	uint64_t left = r->total - *pos;
+	unsigned n = left < max ? (unsigned)left : max;
+	for (unsigned i = 0; i < n; i++) {
+		out[i] = r->bytes[(*pos + i) % LQ_RING_SIZE];
+	}
+	*pos += n;
+	return n;
+}
+#endif
diff --git a/bsd/dev/liuqin_usb_debug.c b/bsd/dev/liuqin_usb_debug.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/liuqin_usb_debug.c
@@ -0,0 +1,988 @@
+/* Liuqin (Xiaomi Pad 6 Pro, SM8475) CDC ACM debug console.
+ *
+ * Opt-in: boot argument liuqin_usb=1. Ported from the vermeer lab console
+ * (github.com/xyyyds0106/ios-vermeer-lab, xnu/vermeer/vermeer_usb_debug.c).
+ *
+ * The port reuses the PHY, clocks and SMMU state that ABL/UEFI already set up.
+ * It never changes GCC, SMMU, PMIC, PHY or storage configuration: every guard
+ * below can only decide to leave the controller untouched, and the normal boot
+ * continues when it does.
+ *
+ * SM8475 constants and their evidence:
+ *   DWC3           0x0a600000, wrapper window 0xfc100   linux sm8450.dtsi usb@a600000
+ *   QSCRATCH       0x0a6f8800 (base + 0xf8800)          inside that window, dwc3-qcom glue
+ *   USB30_PRIM GDSC  GCC + 0x49004                      gcc-sm8450.c usb30_prim_gdsc
+ *   master clock halt GCC + 0x49018                     gcc-sm8450.c gcc_usb30_prim_master_clk
+ *   cfg_noc halt     GCC + 0x49084                      gcc-sm8450.c gcc_cfg_noc_usb3_prim_axi_clk
+ *   aggre halt       GCC + 0x49088                      gcc-sm8450.c gcc_aggre_usb3_prim_axi_clk
+ *   GCC block base  0x149000 (GCC 0x100000 + 0x49000)   linux sm8450.dtsi clock-controller
+ *   APPS SMMU       0x15000000, window 0x100000         linux sm8450.dtsi iommu@15000000
+ *   USB stream ID   0x0                                 linux sm8450.dtsi iommus
+ *
+ * Register order and endpoint protocol follow Linux drivers/usb/dwc3 and the
+ * vermeer reference. DMA memory is permanent: a timeout never frees it.
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <kern/kalloc.h>
+#include <mach/thread_act.h>
+#include <machine/machine_routines.h>
+#include <arm/caches_internal.h>
+#include <vm/pmap.h>
+#include <vm/vm_kern.h>
+#include <pexpert/pexpert.h>
+#include "liuqin_usb_protocol.h"
+
+#define DWC3_PA        0x0a600000ULL
+#define DWC3_SIZE      0x0e000
+#define QSCRATCH_PA    0x0a6f8800ULL
+#define GCC_PA         0x149000ULL
+#define GCC_GDSC_OFF   0x04
+#define GCC_MASTER_OFF 0x18
+#define GCC_CFG_OFF    0x84
+#define GCC_AGGRE_OFF  0x88
+#define SMMU_PA        0x15000000ULL
+#define SMMU_SIZE      0x0d0000
+#define USB_SID_DEF    0x00000000U
+#define SMMU_SMR_COUNT 128
+#define DMA_LO_DEF     0x80000000ULL
+#define DMA_HI_DEF     0x100000000ULL
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern vm_offset_t liuqin_io_map(vm_offset_t, vm_size_t);
+/* liuqin: no flush_mmu_tlb symbol exists in this kernel image, do it inline */
+static void
+liuqin_tlb_flush(void)
+{
+	__asm__ volatile("dsb sy; tlbi vmalle1; dsb sy; isb" ::: "memory");
+}
+
+extern ppnum_t pmap_find_phys(pmap_t, addr64_t);
+/*
+ * Early identity mapping for MMIO through the bootstrap V=P table that start.s
+ * built and arm_vm_init left in TTBR0.
+ *
+ * ml_io_map() must not be used this early: it allocates from kernel_map, and
+ * those allocations wait for the pageout thread, which only starts at the end of
+ * kernel_bootstrap_thread. Mapping the framebuffer there hung the boot at
+ * bsd_init. GCC (0x149000), DWC3 (0xa600000) and the SMMU (0x15000000) all live
+ * in L1 slot 0, which the bootstrap table leaves empty, so one private L2 page
+ * covers them. Slots that already hold a table are refused rather than patched.
+ */
+extern uint8_t bootstrap_pagetables[];
+
+static uint64_t lq_io_l2[512] __attribute__((aligned(4096)));
+static bool lq_io_l2_used;
+
+vm_offset_t
+liuqin_io_map(vm_offset_t pa, vm_size_t size)
+{
+	uint64_t *l1tab = (uint64_t *)(void *)bootstrap_pagetables;
+	uint64_t first = (uint64_t)pa & ~0x1FFFFFULL;
+	uint64_t last = ((uint64_t)pa + size + 0x1FFFFFULL) & ~0x1FFFFFULL;
+	uint64_t slot = (first >> 30) & 0x1FF;
+	uint64_t table;
+	uint64_t va;
+
+	if (lq_io_l2_used || size == 0 || last <= first) {
+		return 0;
+	}
+	if (((last - 1) >> 30 & 0x1FF) != slot) {
+		return 0;
+	}
+	if ((l1tab[slot] & 3) != 0) {
+		return 0;
+	}
+	for (unsigned i = 0; i < 512; i++) {
+		lq_io_l2[i] = 0;
+	}
+	table = (uint64_t)pmap_find_phys(kernel_pmap, (addr64_t)(uintptr_t)lq_io_l2);
+	if (table == 0) {
+		return 0;
+	}
+	table = (table << 12) & 0x0000FFFFFFFFF000ULL;
+	for (va = first; va < last; va += 0x200000ULL) {
+		lq_io_l2[(va >> 21) & 0x1FF] =
+		    (va & 0x0000FFFFFFE00000ULL) | 0x601ULL;
+	}
+	l1tab[slot] = table | 3;
+	lq_io_l2_used = true;
+	liuqin_tlb_flush();
+	return pa;
+}
+
+extern ppnum_t pmap_find_phys(pmap_t, addr64_t);
+extern unsigned liuqin_debug_copy(uint64_t *, char *, unsigned);
+extern uint64_t liuqin_debug_total(void);
+extern uint64_t liuqin_debug_dropped(void);
+extern void liuqin_fb_bind(uint64_t, uint32_t, uint32_t, uint32_t);
+extern void liuqin_fb_band(unsigned, uint32_t);
+void liuqin_usb_debug_start(void);
