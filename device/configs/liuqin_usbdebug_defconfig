# liuqin USB-debug kernel: liuqin_defconfig minus the two sheng-only components that
# need device-side sources this repository does not carry yet. Use this config when
# the goal is the USB CDC-ACM debug port (LIQDBG001) and kernel logs, not the GUI.
#
#   XNU_BOOT_PROGRESS   n  needs scripts/build-boot-progress.py + package/BootProgress.c,
#                           which are sheng's; the on-screen diagnostic page comes back
#                           when they are ported. Kernel console bytes still reach USB.
#   XNU_NATIVE_ADRENO   n  sheng research targets the A740; liuqin is an A730 and the
#                           Adreno build pulls the mesa/LLVM kits.
#
# Kernel configuration of the liuqin image (derived from sheng_defconfig). CONFIG_XNU_<NAME> becomes XNU_<NAME> for the kernel build.

CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_SOURCE_PTHREAD=y
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
CONFIG_XNU_NATIVE_UFS=y
CONFIG_XNU_NATIVE_AES=y
CONFIG_XNU_NATIVE_VIRTIO_BLOCK=y
CONFIG_XNU_NATIVE_RAM_BLOCK=y
CONFIG_XNU_TRUST_CACHE_RUNTIME=y
CONFIG_XNU_SOURCE_MOCKFS=y
CONFIG_XNU_NATIVE_CS_HASH_CACHE=y
CONFIG_XNU_VERIFIED_ROOT_PROBE=y
CONFIG_XNU_OWNER_ROOT_AUDIT=y
CONFIG_XNU_OWNER_ROOT_TRUST=y
# TODO(liuqin): 暂用 sheng 的 SMEM/PMGR 探测代码，需在 SM8475 上验证或改名
CONFIG_XNU_SHENG_PMGR=y
CONFIG_XNU_OWNER_CACHE_MOUNT=y
CONFIG_XNU_OWNER_CACHE_STARTUP=y
CONFIG_XNU_OWNER_BOOT_MANIFEST=y
CONFIG_XNU_OWNER_DATA_MOUNT=y
CONFIG_XNU_OWNER_UNION_SYSTEMOS=y
CONFIG_XNU_DT_PANIC_REGION=y
CONFIG_XNU_ZONE_PGZ_ALIGNMENT_PROBE=y
CONFIG_XNU_NATIVE_ARCH_TIMER=y
CONFIG_XNU_NATIVE_PAN=y
CONFIG_XNU_BOOT_PROGRESS=n
CONFIG_XNU_NATIVE_LEGACY_DISPLAY=y
# TODO(liuqin): sheng 的 Adreno 研究针对 A740，liuqin 是 A730
CONFIG_XNU_NATIVE_ADRENO=n

CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked"
# TODO(liuqin): 换成本机 scratch Data 卷 UUID（sheng 的值仅为占位）
CONFIG_XNU_OWNER_DATA_VOLUME_UUID="18AB5557-DC2D-469B-8758-855E60F5B0DF"
CONFIG_XNU_NATIVE_VIRTIO_BLOCK_ARCHIVE="{tree}/build/native-virtio-block-verified-bundle/libNativeVirtioBlock.a"
CONFIG_XNU_VERIFIED_ROOT_ARCHIVE="{tree}/build/verified-root-os-xnu-bundle/libVerifiedRootProbe.a"
CONFIG_XNU_EXTRA_LD_ARCHIVES=""
CONFIG_XNU_NATIVE_MOBILE_DISPLAY=n
CONFIG_XNU_ARMVIRT_PLATFORM=n

