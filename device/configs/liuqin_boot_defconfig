# Minimal liuqin kernel for the USB CDC-ACM debug port (LIQDBG001).
#
# Only the components that either live entirely in the XNU patch set or are built
# by the base UniXNU scripts are enabled. Everything that needs a device-side
# archive builder this repository does not carry yet (NativeAES, NativeUfs,
# NativeVirtioBlock/RamBlock, legacy/mobile display, verified-owner root chain,
# boot-progress page, Adreno) stays off, so `unixnu build kernel` can finish.
# The port starts at bsd_init(), which is reached without any of them.

CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_SOURCE_PTHREAD=y
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
CONFIG_XNU_NATIVE_ARCH_TIMER=y
CONFIG_XNU_NATIVE_PAN=y
CONFIG_XNU_DT_PANIC_REGION=y
# The defconfig opts into the [kernel] archives builders of board.toml: the kernel
# link needs their output (corecrypto closure, ArmDTPlatform, ArmCpu, libpthread).
CONFIG_XNU_BUILD_ARCHIVES=y
CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked"
CONFIG_XNU_EXTRA_LD_ARCHIVES=""

CONFIG_XNU_NATIVE_UFS=n
CONFIG_XNU_NATIVE_AES=n
CONFIG_XNU_NATIVE_VIRTIO_BLOCK=n
CONFIG_XNU_NATIVE_RAM_BLOCK=n
CONFIG_XNU_NATIVE_LEGACY_DISPLAY=n
CONFIG_XNU_NATIVE_MOBILE_DISPLAY=n
CONFIG_XNU_NATIVE_ADRENO=n
CONFIG_XNU_BOOT_PROGRESS=n
CONFIG_XNU_SOURCE_MOCKFS=n
CONFIG_XNU_NATIVE_CS_HASH_CACHE=n
CONFIG_XNU_TRUST_CACHE_RUNTIME=n
CONFIG_XNU_VERIFIED_ROOT_PROBE=n
CONFIG_XNU_OWNER_ROOT_AUDIT=n
CONFIG_XNU_OWNER_ROOT_TRUST=n
CONFIG_XNU_OWNER_CACHE_MOUNT=n
CONFIG_XNU_OWNER_CACHE_STARTUP=n
CONFIG_XNU_OWNER_BOOT_MANIFEST=n
CONFIG_XNU_OWNER_DATA_MOUNT=n
CONFIG_XNU_OWNER_UNION_SYSTEMOS=n
CONFIG_XNU_OWNER_CRYPTEX_FILES=n
CONFIG_XNU_SHENG_PMGR=n
CONFIG_XNU_ZONE_PGZ_ALIGNMENT_PROBE=n
CONFIG_XNU_ARMVIRT_PLATFORM=n
